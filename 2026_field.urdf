    <link name="arena_border_front">
        <visual>
            <origin xyz="-3.475 0.0 0.2"/>
            <geometry>
                <box size="0.05 9.05 0.4"/>
            </geometry>
            <material name="border_mat"/>
        </visual>

        <collision>
            <origin xyz="-3.475 0.0 0.2"/>
            <geometry>
                <box size="0.05 9.05 0.4"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.5"/>
            <inertia ixx="10.25" ixy="0" ixz="0"
                    iyy="0.02" iyz="0"
                    izz="10.23"/>
        </inertial>
    </link>

    <joint name="arena_border_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arena_border_front"/>
    </joint>


