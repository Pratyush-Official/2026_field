<?xml version="1.0"?>
<robot name="robocon_2026_field_dual_rotated_forest">

    <material name="left_field_mat"><color rgba="0.925 0.635 0.592 1"/></material>
    <material name="right_field_mat"><color rgba="0.502 0.780 0.886 1"/></material>
    <material name="white_line"><color rgba="1 1 1 1"/></material>
    <material name="yellow"><color rgba="1 1 0 1"/></material>
    <material name="dark_green"><color rgba="0.0 0.4 0.0 1"/></material>
    <material name="norm_green"><color rgba="0.2 0.8 0.2 1"/></material>
    <material name="parr_green"><color rgba="0.6 1.0 0.4 1"/></material>
    <material name="border_mat"><color rgba="0.5 0.3 0.1 1"/></material>
    <material name="r_start"><color rgba="0.87 0.00134 0.00134 1"/></material>
    <material name="tictac_base"><color rgba="1 1 1 1"/></material>
    <material name="b_start"><color rgba="0.0019 0 1 1"/></material>
    <material name="ramp_mat"><color rgba="0.753 0.741 0.714 1"/></material>
    
    <link name="base_link"/>

    <!-- Left and Right Field Surfaces -->
    <link name="left_field_surface">
        <visual><origin xyz="0 3.0 0.0"/><geometry><box size="12.0 6.0 0.001"/></geometry><material name="left_field_mat"/></visual>
        <collision><origin xyz="0 3.0 0.0"/><geometry><box size="12.0 6.0 0.001"/></geometry></collision>
        <inertial><mass value="10.0"/><inertia ixx="30.0" ixy="0" ixz="0" iyy="120.0" iyz="0" izz="150.0"/></inertial>
    </link>
    <joint name="left_field_joint" type="fixed"><parent link="base_link"/><child link="left_field_surface"/><origin xyz="0 0 -0.005"/></joint>

    <link name="right_field_surface">
        <visual><origin xyz="0 -3.0 0.0"/><geometry><box size="12.0 6.0 0.001"/></geometry><material name="right_field_mat"/></visual>
        <collision><origin xyz="0 -3.0 0.0"/><geometry><box size="12.0 6.0 0.001"/></geometry></collision>
        <inertial><mass value="10.0"/><inertia ixx="30.0" ixy="0" ixz="0" iyy="120.0" iyz="0" izz="150.0"/></inertial>
    </link>
    <joint name="right_field_joint" type="fixed"><parent link="base_link"/><child link="right_field_surface"/><origin xyz="0 0 -0.005"/></joint>

    <!-- Borders -->
    <link name="border_x_pos">
        <visual><origin xyz="6.025 0 0.05"/><geometry><box size="0.05 12.0 0.10"/></geometry><material name="border_mat"/></visual>
        <collision><origin xyz="6.025 0 0.05"/><geometry><box size="0.05 12.0 0.10"/></geometry></collision>
        <inertial><mass value="1.0"/><inertia ixx="12.0" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="12.0"/></inertial>
    </link>
    <joint name="border_x_pos_joint" type="fixed"><parent link="base_link"/><child link="border_x_pos"/></joint>

    <link name="border_x_neg">
        <visual><origin xyz="-6.025 0 0.250"/><geometry><box size="0.05 12.0 0.500"/></geometry><material name="border_mat"/></visual>
        <collision><origin xyz="-6.025 0 0.250"/><geometry><box size="0.05 12.0 0.500"/></geometry></collision>
        <inertial><mass value="2.0"/><inertia ixx="24.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="24.0"/></inertial>
